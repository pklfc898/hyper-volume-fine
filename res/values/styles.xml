<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="VfTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/vf_surface</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/vf_primary</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/vf_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/vf_light_system_bars</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
